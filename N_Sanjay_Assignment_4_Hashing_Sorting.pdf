%PreformattedPara
0 0 0 rg
BT 1 0 0 1 5 653.7 Tm /F5 6.3 Tf 7.5 TL (#include <stdio.h>) Tj T* (#include <stdlib.h>) Tj T* (#define M 101) Tj T* (#define CAP 100) Tj T* (#define EMPTY 0) Tj T* (#define USED 1) Tj T* (#define DELETED 2) Tj T*  T* (typedef struct { int key, state; } Slot;) Tj T* (typedef struct { int id, priority, seq; } Job;) Tj T* (static Slot ht[M];) Tj T* (static Job heap[CAP];) Tj T* (static int hn=0, nextSeq=0;) Tj T*  T* (static unsigned hash\(int k\){ int r=k%M; return \(unsigned\)\(r<0?r+M:r\); }) Tj T* (int hsearch\(int k\){) Tj T* (    unsigned i=hash\(k\);) Tj T* (    for\(int c=0;c<M;c++,i=\(i+1\)%M\){) Tj T* (        if\(ht[i].state==EMPTY\) return -1;) Tj T* (        if\(ht[i].state==USED && ht[i].key==k\) return \(int\)i;) Tj T* (    }) Tj T* (    return -1;) Tj T* (}) Tj T* (int hinsert\(int k\){) Tj T* (    if\(hsearch\(k\)>=0\) return 0;) Tj T* (    unsigned i=hash\(k\), tomb=M;) Tj T* (    for\(int c=0;c<M;c++,i=\(i+1\)%M\){) Tj T* (        if\(ht[i].state==DELETED && tomb==M\) tomb=i;) Tj T* (        if\(ht[i].state==EMPTY\){) Tj T* (            if\(tomb!=M\) i=tomb;) Tj T* (            ht[i].key=k; ht[i].state=USED; return 1;) Tj T* (        }) Tj T* (    }) Tj T* (    if\(tomb!=M\){ ht[tomb].key=k; ht[tomb].state=USED; return 1; }) Tj T* (    return -1;) Tj T* (}) Tj T* (int hdelete\(int k\){) Tj T* (    int i=hsearch\(k\); if\(i<0\) return 0;) Tj T* (    ht[i].state=DELETED; return 1;) Tj T* (}) Tj T* (int before\(Job a,Job b\){) Tj T* (    return a.priority<b.priority ||) Tj T* (          \(a.priority==b.priority && a.seq<b.seq\);) Tj T* (}) Tj T* (void push\(Job x\){) Tj T* (    if\(hn==CAP\) return;) Tj T* (    int i=hn++; heap[i]=x;) Tj T* (    while\(i>0\){) Tj T* (        int p=\(i-1\)/2; if\(!before\(heap[i],heap[p]\)\) break;) Tj T* (        Job t=heap[i]; heap[i]=heap[p]; heap[p]=t; i=p;) Tj T* (    }) Tj T* (}) Tj T* (int pop\(Job *out\){) Tj T* (    if\(hn==0\) return 0;) Tj T* (    *out=heap[0]; heap[0]=heap[--hn];) Tj T* (    int i=0;) Tj T* (    for\(;;\){) Tj T* (        int l=2*i+1,r=l+1,s=i;) Tj T* (        if\(l<hn && before\(heap[l],heap[s]\)\) s=l;) Tj T* (        if\(r<hn && before\(heap[r],heap[s]\)\) s=r;) Tj T* (        if\(s==i\) break;) Tj T* (        Job t=heap[i]; heap[i]=heap[s]; heap[s]=t; i=s;) Tj T* (    }) Tj T* (    return 1;) Tj T* (}) Tj T* (void insertionSort\(int a[],int n\){) Tj T* (    for\(int i=1;i<n;i++\){) Tj T* (        int key=a[i],j=i-1;) Tj T* (        while\(j>=0 && a[j]>key\){ a[j+1]=a[j]; j--; }) Tj T* (        a[j+1]=key;) Tj T* (    }) Tj T* (}) Tj T* (void swapInt\(int *a,int *b\){int t=*a;*a=*b;*b=t;}) Tj T* (int part\(int a[],int lo,int hi\){) Tj T* (    int p=a[hi],i=lo-1;) Tj T* (    for\(int j=lo;j<hi;j++\) if\(a[j]<=p\) swapInt\(&a[++i],&a[j]\);) Tj T* (    swapInt\(&a[i+1],&a[hi]\); return i+1;) Tj T* (}) Tj T* (void quickSort\(int a[],int lo,int hi\){) Tj T* (    if\(lo<hi\){int p=part\(a,lo,hi\);quickSort\(a,lo,p-1\);quickSort\(a,p+1,hi\);}) Tj T* (}) Tj T* (int main\(void\){) Tj T* (    int a[]={29,10,14,37,13,5,22}, n=7;) Tj T* (    hinsert\(22\); hinsert\(33\); hinsert\(44\);) Tj T* (    printf\("Hash search 33: %s\\\\n",hsearch\(33\)>=0?"Found":"Not found"\);) Tj T* (    hdelete\(33\); printf\("Hash search 33 after delete: %s\\\\n",) Tj T* (        hsearch\(33\)>=0?"Found":"Not found"\);) Tj T* (    Job j1={101,3,nextSeq++},j2={102,1,nextSeq++},j3={103,2,nextSeq++};) Tj T* ET
